{
	# Let's Encrypt needs a contact address for expiry warnings.
	email {$ACME_EMAIL}
}

# ★ OPERATOR-ENABLED SITES, FROM A MOUNT THIS REPO DOES NOT WRITE ★
#
# /etc/caddy-sites is /srv/grims/caddy on the host (see compose.prod.yml) —
# NOT part of this repo's mount. Site blocks that depend on material a deploy
# cannot provide (the grims-squad.com block needs its Cloudflare Origin CA
# certificate pair on disk first) are STAGED in infra/caddy/sites/ and copied
# into /srv/grims/caddy by the operator once their prerequisites exist.
#
# A glob, deliberately: a glob that matches nothing is a warning, not an error,
# so this line is inert until the operator enables a site — whereas importing
# infra/caddy/sites/ directly would load the grims-squad.com block on the next
# deploy and fail the whole config for want of certificates that are not
# installed yet. The cutover order lives in infra/cutover-grims-squad.md.
import /etc/caddy-sites/*.caddy

# Both hostnames are listed so the move to the real domain needs no config
# change and no downtime — Caddy obtains a certificate for grims-squad.com the
# moment its DNS points here, and until then that name simply never resolves.
#
# sslip.io is what makes HTTPS possible before we own DNS: it resolves
# 45-63-35-93.sslip.io to 45.63.35.93, and because it is a real hostname rather
# than a bare IP, Let's Encrypt will issue for it. A certificate authority
# cannot issue a normal certificate for an IP address, so the alternative was a
# self-signed cert and a browser warning on every visit.
{$SITE_HOSTNAMES} {
	encode zstd gzip

	# Access logging was NOT enabled originally, and the first time a member
	# reported a problem there was no record of their request AT ALL — not the
	# URL, not the status, nothing. An edge proxy that logs nothing turns every
	# support question into guesswork.
	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}

	# Security headers applied at the edge, so they cover every response
	# including static assets and error pages that never reach Next.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# The API is same-origin under /v1, which means the session cookie needs no
	# cross-site relaxation: it can stay SameSite=Lax rather than None, and
	# there is no CORS preflight on every call.
	handle /v1/* {
		reverse_proxy api:5001 {
			# ★ RETRY ACROSS A CONTAINER SWAP ★
			#
			# Measured during a deploy: two seconds of 502 while the API
			# container was replaced. `docker compose up -d` has no rolling
			# replacement — it stops the old container and starts the new one,
			# and every request arriving in that window has nowhere to go.
			#
			# `lb_try_duration` makes Caddy HOLD a request and retry the
			# upstream instead of answering 502. The gap is short and bounded by
			# the deploy's own health gate, so a request that arrives mid-swap
			# waits a moment and then succeeds — which is what "zero downtime"
			# has to mean when there is one instance of the service.
			#
			# ★ NO `fail_duration`, AND THAT IS THE WHOLE FIX ★
			#
			# It was set to 5s and MADE THINGS WORSE — measured: two seconds of
			# 502 became nine. `fail_duration` takes a failing upstream out of
			# rotation for that long. With several upstreams that is exactly
			# right; with ONE it removes the only backend there is, and Caddy
			# then answers 502 immediately instead of retrying, for the whole
			# five seconds. The setting that was supposed to help was doing the
			# opposite.
			#
			# With no fail_duration the upstream is never blacklisted, so
			# `lb_try_duration` keeps retrying the same address until the new
			# container accepts a connection.
			#
			# 45s, not 10s: the window is not the swap, it is the NEW container
			# booting. Node, Nest and Prisma take a few seconds, and the API's
			# healthcheck allows a 30s start period. Ten seconds covered the
			# gap between containers and expired long before the replacement was
			# listening.
			lb_try_duration 45s
			lb_try_interval 250ms
		}
	}

	handle {
		reverse_proxy web:5000 {
			# Same reasoning, and no fail_duration for the same reason: one
			# upstream, so blacklisting it removes the only one. Next needs a
			# moment to come up too.
			lb_try_duration 45s
			lb_try_interval 250ms
		}
	}
}

# syntax=docker/dockerfile:1
#
# Web image. Uses Next's standalone output, which traces exactly the files the
# server needs and drops the rest — a few hundred MB rather than the whole
# monorepo's node_modules.
FROM node:24-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable

FROM base AS build
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @grims/shared build
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @grims/web build

FROM base AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=5000 HOSTNAME=0.0.0.0
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
RUN useradd -r -u 10002 -m grims && chown -R grims:grims /app
USER grims
EXPOSE 5000
CMD ["node", "apps/web/server.js"]

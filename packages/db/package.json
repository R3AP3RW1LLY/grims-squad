{
  "name": "@grims/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma client, schema and migrations. Schema is COPIED from ssot/03-data.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.spec.ts\" --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@grims/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "prisma": "^6.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

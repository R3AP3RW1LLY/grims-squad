{
  "name": "@grims/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas, DTOs, enums and the permission bitmask. Used by BOTH ends.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./forum-signature": {
      "types": "./dist/forum-signature.d.ts",
      "default": "./dist/forum-signature.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./ai-knowledge": {
      "types": "./dist/ai-knowledge.d.ts",
      "default": "./dist/ai-knowledge.js"
    },
    "./ai-corpus": {
      "types": "./dist/ai-corpus.d.ts",
      "default": "./dist/ai-corpus.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "default": "./dist/permissions.js"
    },
    "./tenure": {
      "types": "./dist/tenure.d.ts",
      "default": "./dist/tenure.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly && tsc -p tsconfig.spec.json",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@grims/config": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}

{
  "name": "@grims/eddn-collector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ZeroMQ subscriber. The EDDN firehose into Postgres. Singleton.",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly && tsc -p tsconfig.spec.json",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/index.js",
    "dev": "node ../../tools/keep-alive.mjs eddn-collector -- tsx watch --env-file-if-exists=../api/.env src/index.ts",
    "dev:once": "tsx watch --env-file-if-exists=../api/.env src/index.ts"
  },
  "devDependencies": {
    "@grims/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@grims/db": "workspace:*",
    "@grims/shared": "workspace:*",
    "pg": "^8.22.0",
    "zeromq": "^6.5.0"
  }
}

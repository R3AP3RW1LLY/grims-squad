{
  "name": "@grims/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BullMQ processors. Spansh jobs, digests, retention, reconciliation.",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo",
    "reconcile": "tsx src/main.ts",
    "promote": "tsx src/promote.ts",
    "inara:sync": "tsx src/inara-sync.ts"
  },
  "devDependencies": {
    "@grims/config": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "@grims/db": "workspace:*",
    "@grims/ed-clients": "workspace:*",
    "@grims/shared": "workspace:*",
    "pino": "^10.3.1"
  }
}

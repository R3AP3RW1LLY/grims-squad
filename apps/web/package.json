{
  "name": "@grims/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js 15 App Router. Public pages and the authed SPA shell.",
  "scripts": {
    "dev": "next dev -p 5000",
    "build": "next build",
    "start": "next start -p 5000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "clean": "rm -rf .next dist",
    "predev": "node -e \"const fs=require('fs');if(fs.existsSync('.next/BUILD_ID')){fs.rmSync('.next',{recursive:true,force:true});console.log('Cleared a production .next before starting dev.')}\"",
    "build:check": "cross-env NEXT_DIST_DIR=.next-check next build"
  },
  "devDependencies": {
    "@grims/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@grims/ed-clients": "workspace:*",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "next": "^15.5.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}

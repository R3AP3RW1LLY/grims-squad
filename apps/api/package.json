{
  "name": "@grims/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS + Fastify. REST, WebSocket, all business logic and authorization.",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly && tsc -p tsconfig.spec.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.spec.ts\"",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "seed:guides": "tsx --env-file-if-exists=.env scripts/seed-guides.ts",
    "verify:uploads": "tsx --env-file-if-exists=.env scripts/verify-upload-chain.ts"
  },
  "devDependencies": {
    "@grims/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@types/sanitize-html": "^2.16.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^10.2.2",
    "@grims/db": "workspace:*",
    "pg": "^8.22.0",
    "@grims/ed-clients": "workspace:*",
    "@grims/shared": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "markdown-it": "^14.3.0",
    "meilisearch": "^0.60.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  }
}

{
  "name": "@grims/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS + Fastify. REST, WebSocket, all business logic and authorization.",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.spec.ts\"",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@grims/config": "workspace:*",
    "@types/node": "^24.13.3",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@grims/db": "workspace:*",
    "@grims/ed-clients": "workspace:*",
    "@grims/shared": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "meilisearch": "^0.60.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3",
    "@fastify/rate-limit": "^10.2.2"
  }
}

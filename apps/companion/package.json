{
  "name": "@grims/companion",
  "version": "0.5.0",
  "private": true,
  "description": "Electron companion. Reads Elite Dangerous journals and keeps the hub current.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc -b && node make-icons.mjs && node build.mjs",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly && tsc -p tsconfig.spec.json",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "start": "pnpm build && node dev.mjs",
    "dist": "electron-builder --win --mac --linux",
    "dist:win": "electron-builder --win",
    "clean": "rm -rf dist release *.tsbuildinfo",
    "start:prod": "pnpm build && node prod.mjs"
  },
  "devDependencies": {
    "@grims/config": "workspace:*",
    "@grims/ed-clients": "workspace:*",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@grims/shared": "workspace:*",
    "chart.js": "^4.5.1",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.4",
    "preact": "^10.29.8"
  }
}

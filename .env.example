# Grim's Squad Hub — environment template
#
# PLACEHOLDERS ONLY. Never commit a real value to this file (INV-036).
# Production secrets live in a root-owned 0600 /srv/grims/.env ON THE SERVER,
# never in git (decision D6). See ssot/09-runbooks/secrets-rotation.md.

NODE_ENV=development
LOG_LEVEL=debug

# ---- Database ----------------------------------------------------------------
# Image MUST be timescale/timescaledb-ha:pg16 — it bundles both TimescaleDB and
# pgvector. Neither stock image has both (decision D10).
DATABASE_URL=postgresql://grims:CHANGE_ME@localhost:5432/grimssquad?schema=public

# ---- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Meilisearch -------------------------------------------------------------
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=CHANGE_ME

# ---- Sessions ----------------------------------------------------------------
# Dual-key rotation: JWT_SIGNING_KEY signs, JWT_SIGNING_KEY_PREVIOUS still verifies.
JWT_SIGNING_KEY=CHANGE_ME_32_BYTES_MINIMUM
JWT_SIGNING_KEY_PREVIOUS=
# AES-256-GCM key for tokens at rest (INV-012). Rotating this requires the
# re-encryption procedure in secrets-rotation.md — it is NOT a simple swap.
TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_HEX
TOKEN_ENCRYPTION_KEY_VERSION=1

# ---- Discord -----------------------------------------------------------------
# The real guild ID is recorded in ssot/STATUS.md (decision D2) and in your local
# TODO. It is deliberately NOT here: this file says PLACEHOLDERS ONLY, and an
# 18-digit snowflake in a committed config file is indistinguishable from a leaked
# client ID to any scanner - including ours, which correctly flagged it.
DISCORD_GUILD_ID=CHANGE_ME
DISCORD_CLIENT_ID=CHANGE_ME
DISCORD_CLIENT_SECRET=CHANGE_ME
# Requires the SERVER MEMBERS privileged intent, or guild_roles is silently empty.
DISCORD_BOT_TOKEN=CHANGE_ME

# ---- Frontier cAPI (P1.8, gated on approval) ---------------------------------
FRONTIER_CLIENT_ID=CHANGE_ME
FRONTIER_REDIRECT_URI=https://grims-squad.com/v1/auth/frontier/callback

# ---- Inara (P1.8b, gated on whitelisting) ------------------------------------
# Global limit is ~2 req/min across the WHOLE application (INV-033).
INARA_API_KEY=CHANGE_ME
INARA_APP_NAME=GrimsSquadHub

# ---- Object storage (Vultr, S3-compatible) -----------------------------------
S3_ENDPOINT=https://CHANGE_ME.vultrobjects.com
S3_REGION=us-east-1
S3_BUCKET=grims-squad-uploads
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# ---- Squadron ----------------------------------------------------------------
SQUADRON_HOME_SYSTEM_ADDRESS=9467852891473
EDDN_PREFILTER_RADIUS_LY=500

# ---- GSAI (P8) ---------------------------------------------------------------
GSAI_GATEWAY_URL=http://localhost:8443
GSAI_HMAC_KEY=CHANGE_ME
OLLAMA_INTERACTIVE_HOST=http://127.0.0.1:11434
OLLAMA_HEAVY_HOST=http://127.0.0.1:11435

# ---- Public ------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:5000
API_BASE_URL=http://localhost:5001

# ---------------------------------------------------------------- P1.1 auth --
# Discord sign-in. If ANY of these is blank the auth routes answer 503 and the
# rest of the API boots normally — partial configuration is treated as none.
DISCORD_CLIENT_ID=CHANGE_ME
DISCORD_CLIENT_SECRET=CHANGE_ME
DISCORD_GUILD_ID=CHANGE_ME
DISCORD_REDIRECT_URI=http://localhost:5001/v1/auth/discord/callback

# HMAC secret for the OAuth state token. Minimum 32 chars; the app refuses to
# start with a shorter one, because a forgeable state is the whole protection.
#   openssl rand -base64 48
OAUTH_STATE_SECRET=CHANGE_ME

# Envelope-encryption keyring for OAuth/cAPI/device tokens (INV-012).
# Format: <keyId>:<base64-32-byte-key>[,<keyId>:<key>...] — FIRST entry encrypts,
# every entry can decrypt, which is what makes rotation additive.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEYRING=CHANGE_ME

# Discord IDs bootstrapped into the `webmaster` role on login. Comma-separated.
#
# This list lives in CONFIGURATION rather than the database on purpose: an
# attacker who fully compromises an account with site permissions still cannot
# add themselves here without server access, so there is always a recovery path
# they cannot close from inside the application. It is also why an accidental
# self-revoke is survivable — the next login by a listed ID re-asserts the role.
#
# Anything that is not a 17-20 digit snowflake makes the app refuse to start.
WEBMASTER_BOOTSTRAP_DISCORD_IDS=CHANGE_ME

# Roles applied by the join-the-server flow. These are the ONLY roles it can
# ever grant. Right-click the role in Discord (Developer Mode on) -> Copy Role ID.
# Kept out of source deliberately: INV-008, so renaming a role needs no deploy.
DISCORD_ROLE_SQUADRON=CHANGE_ME
DISCORD_ROLE_ALLY=CHANGE_ME

# The channel the bot watches for member activity (rank progression, phase 1).
# Right-click the channel in Discord (Developer Mode on) -> Copy Channel ID.
DISCORD_ACTIVITY_CHANNEL_ID=CHANGE_ME

# Voice channels that count toward monthly activity. Comma-separated ids.
# Explicit rather than permission-derived: a derived list would silently opt in
# every future channel, including ones nobody meant to count.
DISCORD_VOICE_CHANNEL_IDS=CHANGE_ME

# Where uploads go when S3 is NOT configured (development only).
#
# Unset falls back to `.local-storage` under the API's working directory. Set it to keep member
# screenshots off the repo drive — training images add up fast, and a Docker build that copies the
# working tree should not be copying a few gigabytes of somebody's holiday snaps.
#
# Windows: MEDIA_LOCAL_ROOT=D:/grims-media
MEDIA_LOCAL_ROOT=
